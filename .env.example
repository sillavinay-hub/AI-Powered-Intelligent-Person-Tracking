# ==============================================================================
# ResortVision AI - Configuration
# ==============================================================================

# Application
APP_NAME="ResortVision AI"
APP_ENV=development
DEBUG=True
PORT=8000
HOST=0.0.0.0

# Database Configuration (PostgreSQL supported, SQLite default for zero-setup demo)
# PostgreSQL example: postgresql://resort_user:resort_pass@localhost:5432/resortvision
DATABASE_URL=sqlite:///./resortvision.db

# Security & JWT Authentication
# IMPORTANT: Generate a secure random string in production (e.g. openssl rand -hex 32)
SECRET_KEY=resortvision-ai-super-secret-key-change-in-production-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# AI Hardware & Model Settings
# DEVICE: 'auto', 'cuda', or 'cpu'
DEVICE=auto
AI_FRAME_RATE=10
MAX_TRACKING_AGE=30

# Multimodal Identity Fusion Weights (Starting baseline from research specification)
W_FACE=0.40
W_REID=0.35
W_TEMPORAL=0.15
W_CAMERA=0.10

# Decision Thresholds
FACE_THRESHOLD=0.60
REID_THRESHOLD=0.55
IDENTITY_THRESHOLD=0.65
UNKNOWN_THRESHOLD=0.45

# Demo & Simulation Mode
DEMO_MODE=True
ENABLE_SYNTHETIC_CAMERAS=True

# Data Retention & Privacy
DATA_RETENTION_DAYS=30
LOG_LEVEL=INFO
